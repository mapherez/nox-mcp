{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "NoX Suite 1.0 gateway-source",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "1.0"
    },
    "registration": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "NoX Suite 1.0 registration-record; complete-document preservation; semantic rules in GATEWAY_CONTRACT.md.",
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "1.0",
          "type": "string"
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "x-nox-kind": "product-id",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "associationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "declaration": {
          "type": "object",
          "properties": {
            "contractVersion": {
              "const": "1.0",
              "type": "string"
            },
            "productId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "x-nox-kind": "product-id",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "productVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "capabilities": {
              "type": "object",
              "properties": {
                "suiteMcp": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "x-nox-kind": "path"
                    }
                  },
                  "required": [
                    "path"
                  ],
                  "additionalProperties": true
                }
              },
              "required": [],
              "additionalProperties": true
            },
            "requires": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "uniqueItems": true
            }
          },
          "required": [
            "contractVersion",
            "productId",
            "productVersion",
            "displayName",
            "capabilities"
          ],
          "additionalProperties": true
        },
        "connection": {
          "type": "object",
          "properties": {
            "baseUrl": {
              "type": "string",
              "minLength": 9,
              "maxLength": 2048,
              "x-nox-kind": "origin"
            }
          },
          "required": [
            "baseUrl"
          ],
          "additionalProperties": true
        },
        "managedBy": {
          "type": "object",
          "properties": {
            "productId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "x-nox-kind": "product-id",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "deploymentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "productId",
            "deploymentId"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "contractVersion",
        "productId",
        "revision",
        "associationId",
        "declaration",
        "connection"
      ],
      "additionalProperties": true
    },
    "serverId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "viewId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "inputSchema": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": true
              },
              "outputSchema": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": true
              },
              "_meta": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": true
              }
            },
            "required": [
              "name",
              "inputSchema"
            ],
            "additionalProperties": true
          },
          "cli": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": true
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "availability": {
            "type": "string",
            "enum": [
              "available",
              "unavailable"
            ]
          }
        },
        "required": [
          "tool"
        ],
        "additionalProperties": false
      }
    },
    "catalog": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "presentation": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "ttlMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "contractVersion",
    "registration",
    "serverId",
    "viewId",
    "definitions"
  ],
  "additionalProperties": true
}
