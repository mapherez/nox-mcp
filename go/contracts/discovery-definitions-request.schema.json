{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "catalog",
    "tools"
  ],
  "properties": {
    "_meta": {
      "type": "object"
    },
    "catalog": {
      "type": "string",
      "minLength": 1
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "name",
          "fingerprint"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
