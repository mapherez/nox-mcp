{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "NoX Suite 1.0 probe-claims; complete-document preservation; semantic rules in GATEWAY_CONTRACT.md.",
  "type": "object",
  "properties": {
    "iss": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "aud": {
      "type": "string",
      "minLength": 9,
      "maxLength": 4096
    },
    "sub": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "iat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nbf": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "exp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "jti": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "nox": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "1.0",
          "type": "string"
        },
        "serviceCredentialRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "x-nox-kind": "product-id",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "registrationRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "associationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "purpose": {
          "type": "string",
          "const": "mcp-probe"
        }
      },
      "required": [
        "contractVersion",
        "serviceCredentialRevision",
        "productId",
        "registrationRevision",
        "associationId",
        "purpose"
      ],
      "additionalProperties": true,
      "not": {
        "anyOf": [
          {
            "required": [
              "keyId"
            ]
          },
          {
            "required": [
              "authRevision"
            ]
          }
        ]
      }
    },
    "scope": {
      "type": "string",
      "const": "nox:mcp-probe"
    }
  },
  "required": [
    "iss",
    "aud",
    "sub",
    "iat",
    "nbf",
    "exp",
    "jti",
    "nox",
    "scope"
  ],
  "additionalProperties": true,
  "not": {
    "required": [
      "act"
    ]
  }
}
