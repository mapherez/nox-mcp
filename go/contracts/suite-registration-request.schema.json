{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "NoX Suite 1.0 registration-request; complete-document preservation; semantic rules in GATEWAY_CONTRACT.md.",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "baseUrl": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "x-nox-kind": "origin"
    },
    "managedBy": {
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "x-nox-kind": "product-id",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "deploymentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "productId",
        "deploymentId"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "contractVersion",
    "baseUrl"
  ],
  "additionalProperties": true
}
