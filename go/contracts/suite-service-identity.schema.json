{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "NoX Suite 1.0 service-identity; complete-document preservation; semantic rules in GATEWAY_CONTRACT.md.",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "serviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "credentialId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "credentialRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "productId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "x-nox-kind": "product-id",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "associationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "registry.read",
          "registry.manage-associated",
          "authorization.delegate",
          "events.read",
          "lifecycle.report",
          "mcp.report",
          "mcp.probe",
          "pairing.manage-associated"
        ]
      },
      "uniqueItems": true
    },
    "expiresAt": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40,
      "x-nox-kind": "timestamp",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"
    }
  },
  "required": [
    "contractVersion",
    "serviceId",
    "credentialId",
    "credentialRevision",
    "productId",
    "associationId",
    "grants"
  ],
  "additionalProperties": true
}
