{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "NoX Suite 1.0 authorization-response; complete-document preservation; semantic rules in GATEWAY_CONTRACT.md.",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "tokenType": {
      "type": "string",
      "const": "Bearer"
    },
    "accessToken": {
      "type": "string",
      "minLength": 5,
      "maxLength": 16384,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    },
    "expiresAt": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40,
      "x-nox-kind": "timestamp",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"
    },
    "context": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "1.0",
          "type": "string"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "authRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "gatewayServiceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "serviceCredentialRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "x-nox-kind": "product-id",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "registrationRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "associationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "nox:inspect",
              "nox:write",
              "nox:sensitive-read"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "contains": {
            "const": "nox:inspect"
          }
        }
      },
      "required": [
        "contractVersion",
        "userId",
        "keyId",
        "authRevision",
        "gatewayServiceId",
        "serviceCredentialRevision",
        "productId",
        "registrationRevision",
        "associationId",
        "scopes"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "contractVersion",
    "tokenType",
    "accessToken",
    "expiresAt",
    "context"
  ],
  "additionalProperties": true
}
