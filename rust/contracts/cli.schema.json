{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "version"
  ],
  "additionalProperties": true,
  "properties": {
    "version": {
      "const": "1.0"
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "navigation": {
      "type": "object",
      "properties": {
        "order": {
          "type": "number"
        },
        "label": {
          "type": "string"
        },
        "group": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/pointer"
      },
      "additionalProperties": {
        "$ref": "#/definitions/parameter"
      }
    },
    "preview": {
      "$ref": "#/definitions/preview"
    },
    "confirmation": {
      "$ref": "#/definitions/confirmation"
    },
    "workflow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/step"
      }
    }
  },
  "definitions": {
    "pointer": {
      "type": "string",
      "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
    },
    "source": {
      "type": "object",
      "required": [
        "tool"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pointer"
          },
          "uniqueItems": true
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/binding"
          }
        }
      },
      "additionalProperties": true
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "from",
            "pointer"
          ],
          "properties": {
            "from": {
              "const": "input"
            },
            "pointer": {
              "$ref": "#/definitions/pointer"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "from",
            "step",
            "pointer"
          ],
          "properties": {
            "from": {
              "const": "step"
            },
            "step": {
              "type": "string",
              "minLength": 1
            },
            "pointer": {
              "$ref": "#/definitions/pointer"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "parameter": {
      "type": "object",
      "properties": {
        "order": {
          "type": "number"
        },
        "control": {
          "enum": [
            "text",
            "password",
            "select",
            "multiselect",
            "checkbox",
            "number",
            "textarea"
          ]
        },
        "options": {
          "allOf": [
            {
              "$ref": "#/definitions/source"
            },
            {
              "type": "object",
              "properties": {
                "itemsPointer": {
                  "$ref": "#/definitions/pointer"
                },
                "valuePointer": {
                  "$ref": "#/definitions/pointer"
                },
                "labelPointer": {
                  "$ref": "#/definitions/pointer"
                }
              }
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "preview": {
      "allOf": [
        {
          "$ref": "#/definitions/source"
        },
        {
          "type": "object",
          "properties": {
            "bind": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/definitions/pointer"
              },
              "additionalProperties": {
                "$ref": "#/definitions/pointer"
              }
            },
            "reviewPointer": {
              "$ref": "#/definitions/pointer"
            }
          }
        }
      ]
    },
    "confirmation": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "boolean",
            "typed"
          ]
        },
        "message": {
          "type": "string"
        },
        "matchPointer": {
          "$ref": "#/definitions/pointer"
        },
        "bindPointer": {
          "$ref": "#/definitions/pointer"
        }
      },
      "additionalProperties": true
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "input",
            "call",
            "confirm"
          ]
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pointer"
          }
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pointer"
          }
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/binding"
          }
        },
        "confirmation": {
          "$ref": "#/definitions/confirmation"
        }
      },
      "additionalProperties": true
    }
  }
}
