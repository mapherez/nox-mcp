{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "NoX Suite 1.0 authorization-context; complete-document preservation; semantic rules in GATEWAY_CONTRACT.md.",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "userId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "authRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "gatewayServiceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "serviceCredentialRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "productId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "x-nox-kind": "product-id",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "registrationRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "associationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "nox:inspect",
          "nox:write",
          "nox:sensitive-read"
        ]
      },
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "const": "nox:inspect"
      }
    }
  },
  "required": [
    "contractVersion",
    "userId",
    "keyId",
    "authRevision",
    "gatewayServiceId",
    "serviceCredentialRevision",
    "productId",
    "registrationRevision",
    "associationId",
    "scopes"
  ],
  "additionalProperties": true
}
