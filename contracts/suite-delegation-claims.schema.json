{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "NoX Suite 1.0 delegation-claims; complete-document preservation; semantic rules in GATEWAY_CONTRACT.md.",
  "type": "object",
  "properties": {
    "iss": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "aud": {
      "type": "string",
      "minLength": 9,
      "maxLength": 4096
    },
    "sub": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "act": {
      "type": "object",
      "properties": {
        "sub": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "sub"
      ],
      "additionalProperties": true
    },
    "iat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nbf": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "exp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "jti": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "nox": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "1.0",
          "type": "string"
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "authRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "serviceCredentialRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "x-nox-kind": "product-id",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "registrationRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "associationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "contractVersion",
        "keyId",
        "authRevision",
        "serviceCredentialRevision",
        "productId",
        "registrationRevision",
        "associationId"
      ],
      "additionalProperties": true,
      "not": {
        "required": [
          "purpose"
        ]
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "iss",
    "aud",
    "sub",
    "act",
    "iat",
    "nbf",
    "exp",
    "jti",
    "nox",
    "scope"
  ],
  "additionalProperties": true
}
