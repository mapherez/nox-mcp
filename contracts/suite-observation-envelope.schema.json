{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Accepted observation with authority receive/freshness times.",
  "type": "object",
  "properties": {
    "observation": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "1.0",
          "type": "string"
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "x-nox-kind": "product-id",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "registrationRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "associationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source": {
          "type": "string",
          "enum": [
            "yard",
            "gateway"
          ]
        },
        "producerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "producerEpoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sequence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "x-nox-kind": "sequence",
          "pattern": "^(?:0|[1-9][0-9]*)$"
        },
        "observedAt": {
          "type": "string",
          "minLength": 20,
          "maxLength": 40,
          "x-nox-kind": "timestamp",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "managedBy": {
          "type": "object",
          "properties": {
            "productId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "x-nox-kind": "product-id",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "deploymentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "productId",
            "deploymentId"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "contractVersion",
        "productId",
        "registrationRevision",
        "associationId",
        "source",
        "producerId",
        "producerEpoch",
        "sequence",
        "observedAt",
        "state"
      ],
      "additionalProperties": true,
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "const": "yard"
            },
            "state": {
              "enum": [
                "starting",
                "running",
                "stopping",
                "stopped",
                "restarting",
                "recreating",
                "updating",
                "unknown"
              ]
            },
            "managedBy": {
              "type": "object",
              "properties": {
                "productId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "x-nox-kind": "product-id",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "deploymentId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "productId",
                "deploymentId"
              ],
              "additionalProperties": true
            }
          },
          "required": [
            "source",
            "state",
            "managedBy"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "const": "gateway"
            },
            "state": {
              "enum": [
                "ready",
                "unreachable",
                "notReady",
                "incompatible",
                "unknown"
              ]
            }
          },
          "required": [
            "source",
            "state"
          ],
          "additionalProperties": true
        }
      ]
    },
    "receivedAt": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40,
      "x-nox-kind": "timestamp",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"
    },
    "freshUntil": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40,
      "x-nox-kind": "timestamp",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"
    }
  },
  "required": [
    "observation",
    "receivedAt",
    "freshUntil"
  ],
  "additionalProperties": true
}
