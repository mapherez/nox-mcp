{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "NoX Suite 1.0 pairing-intent; complete-document preservation; semantic rules in GATEWAY_CONTRACT.md.",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "pairingId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "productId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "x-nox-kind": "product-id",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "baseUrl": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "x-nox-kind": "origin"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "product",
        "gateway",
        "installer"
      ]
    },
    "nonce": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "secret": {
      "type": "string",
      "minLength": 43,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "expiresAt": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40,
      "x-nox-kind": "timestamp",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"
    },
    "managedBy": {
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "x-nox-kind": "product-id",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "deploymentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "productId",
        "deploymentId"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "contractVersion",
    "pairingId",
    "productId",
    "baseUrl",
    "purpose",
    "nonce",
    "secret",
    "expiresAt"
  ],
  "additionalProperties": true
}
