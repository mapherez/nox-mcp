{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "NoX Suite 1.0 gateway-presentation; complete-document preservation; semantic rules in GATEWAY_CONTRACT.md.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "registryRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-nox-kind": "product-id",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "registrationRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "serverId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "viewId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "catalog": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43,
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        "required": [
          "productId",
          "registrationRevision",
          "serverId",
          "viewId",
          "catalog"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "version",
    "registryRevision",
    "products"
  ],
  "additionalProperties": true
}
