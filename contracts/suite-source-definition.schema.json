{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "NoX Suite 1.0 source-definition",
  "type": "object",
  "properties": {
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": true
        },
        "outputSchema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": true
        },
        "_meta": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": true
        }
      },
      "required": [
        "name",
        "inputSchema"
      ],
      "additionalProperties": true
    },
    "cli": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "availability": {
      "type": "string",
      "enum": [
        "available",
        "unavailable"
      ]
    }
  },
  "required": [
    "tool"
  ],
  "additionalProperties": false
}
