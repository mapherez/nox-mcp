{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "NoX Suite 1.0 pairing-proof; complete-document preservation; semantic rules in GATEWAY_CONTRACT.md.",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "binding": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "1.0",
          "type": "string"
        },
        "pairingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "nonce": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "x-nox-kind": "product-id",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "declarationFingerprint": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "baseUrl": {
          "type": "string",
          "minLength": 8,
          "maxLength": 2048,
          "x-nox-kind": "origin"
        },
        "tlsPublicKeyFingerprint": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "description": "Required for HTTPS, absent for HTTP. This pins TLS transport; service authorization remains mandatory for both schemes."
        }
      },
      "required": [
        "contractVersion",
        "pairingId",
        "nonce",
        "productId",
        "declarationFingerprint",
        "baseUrl"
      ],
      "additionalProperties": true,
      "x-nox-kind": "pairing-binding"
    },
    "proof": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  },
  "required": [
    "contractVersion",
    "binding",
    "proof"
  ],
  "additionalProperties": true
}
