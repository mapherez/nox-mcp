{
  "name": "@nox/mcp",
  "version": "0.6.0",
  "description": "Native MCP tools, authorization adapters and cancellable desktop bridges for NoX apps",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "contracts:sync": "node scripts/sync-contracts.mjs",
    "contracts:check": "node scripts/sync-contracts.mjs --check",
    "test:conformance": "npm run contracts:check && npm run build && node scripts/check-conformance.mjs",
    "test:discovery": "npm run contracts:check && npm run build && node scripts/check-discovery.mjs",
    "diagnose:go-sse": "npm run contracts:check && npm run build && node scripts/investigate-go-sse.mjs",
    "benchmark:discovery": "npm run build && node scripts/benchmark-discovery.mjs",
    "test:native-packages": "node scripts/check-native-packages.mjs",
    "test:consumers": "node scripts/check-consumers.mjs",
    "build": "node scripts/build.mjs",
    "test": "npm run contracts:check && npm run build && node --test typescript/test/*.test.mjs scripts/*.test.mjs",
    "version:update": "node scripts/update-version.mjs",
    "release": "node scripts/release.mjs",
    "package:check": "node scripts/check-package.mjs",
    "prepack": "npm run contracts:check && npm run build"
  },
  "files": [
    "typescript/dist",
    "LICENSE",
    "README.md",
    "MIGRATION_0_5.md",
    "DISCOVERY.md",
    "COMPATIBILITY_AUDIT.md",
    "contracts/README.md"
  ],
  "exports": {
    ".": {
      "types": "./typescript/dist/index.d.ts",
      "import": "./typescript/dist/index.js"
    },
    "./contract": {
      "types": "./typescript/dist/contract.d.ts",
      "import": "./typescript/dist/contract.js"
    },
    "./bridge": {
      "types": "./typescript/dist/bridge.d.ts",
      "import": "./typescript/dist/bridge.js"
    },
    "./node": {
      "types": "./typescript/dist/node.d.ts",
      "import": "./typescript/dist/node.js"
    },
    "./bridge/client": {
      "types": "./typescript/dist/bridge-client.d.ts",
      "import": "./typescript/dist/bridge-client.js"
    },
    "./bridge/server": {
      "types": "./typescript/dist/bridge-server.d.ts",
      "import": "./typescript/dist/bridge-server.js"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "ajv": "^8.20.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "ws": "^8.19.0",
    "zod": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/node": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/node": "^2.0.0",
    "@types/node": "^24.10.13",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "ws": "^8.19.0",
    "zod": "^4.6.0"
  },
  "private": true
}
